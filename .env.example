# ─────────────────────────────────────────────────────────────
# Configurazione — copiare in .env, compilare, poi: chmod 600 .env
# ─────────────────────────────────────────────────────────────

# ── ACCESSO (obbligatorio) ──────────────────────────────────
# Password unica condivisa in ufficio. Il servizio NON parte senza.
# Espone un indice documentale e consuma una chiave API a pagamento:
# lasciarlo aperto significa regalare entrambi a chiunque trovi il dominio.
# Almeno 12 caratteri; dopo averla cambiata serve 'docker compose restart web'
# per invalidare le sessioni già aperte.
FLER_ACCESS_PASSWORD=

# Solo per uso in locale non raggiungibile da internet:
# FLER_REQUIRE_PASSWORD=false
# Se il servizio gira in HTTP puro (sconsigliato): FLER_COOKIE_SECURE=false

# ── MODELLI ─────────────────────────────────────────────────
FLER_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
FLER_LLM_MODEL=claude-sonnet-4-6

# In alternativa (FLER_LLM_PROVIDER=openai)
OPENAI_API_KEY=
# FLER_LLM_MODEL=gpt-4.1

# Embedding: serve comunque OPENAI_API_KEY
FLER_EMBED_PROVIDER=openai
FLER_EMBED_MODEL=text-embedding-3-small
FLER_EMBED_DIM=1536

# ── CRAWLER ─────────────────────────────────────────────────
# Identificazione verso la Regione: netiquette e tracciabilità.
# Mettere un indirizzo email vero: è così che un amministratore vi contatta
# invece di bloccarvi.
FLER_USER_AGENT=FelBot/1.2 (assistente documentale non ufficiale; +https://felbot.pherio.net/bot)
# Facoltativo: se impostato, viene inviato nell'intestazione From
FLER_CONTACT_EMAIL=

FLER_REQUESTS_PER_SECOND=1.5
FLER_MAX_CONCURRENCY=3
FLER_RESPECT_ROBOTS=true

# Ogni quanti giorni riverificare un documento anche se la data di modifica
# non è cambiata: il portale sostituisce allegati senza toccarla.
FLER_REVALIDATE_DAYS=30

# ── PERCORSI ────────────────────────────────────────────────
FLER_DATA_DIR=./data

# ── SOGLIE DI PRUDENZA ──────────────────────────────────────
# Soglia di pertinenza sotto la quale il sistema si astiene dal rispondere.
# Da calibrare sulle vostre domande reali: vedi §5 del README.
# Abbassarla fa rispondere più spesso, e più spesso a sproposito.
FLER_MIN_RELEVANCE=0.42
FLER_TOP_K=40
FLER_CONTEXT_CHUNKS=14

# ── LIMITI DI FREQUENZA ─────────────────────────────────────
FLER_RATE_LOGIN=5/minute
FLER_RATE_CHAT=30/hour
